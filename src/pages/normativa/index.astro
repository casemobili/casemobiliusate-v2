---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SchemaBreadcrumb from '~/components/SchemaBreadcrumb.astro';
import SchemaWebPage from '~/components/SchemaWebPage.astro';
import SchemaArticle from '~/components/SchemaArticle.astro';
import FaqAccordion from '~/components/FaqAccordion.astro';
import Tldr from '~/components/Tldr.astro';
import FbCommunityWidget from '~/components/FbCommunityWidget.astro';
import ArticleCard from '~/components/ArticleCard.astro';

const url = '/normativa';
const fullUrl = `https://www.casemobiliusate.com${url}`;
const title = 'Casa mobile in Italia: cosa puoi e non puoi fare per legge (2026)';
const description = 'Art. 3 del DPR 380/2001, permesso di costruire, DPR 73/2026, residenza: dove una casa mobile è legale e dove diventa abuso edilizio.';

const toc = [
  { id: 'cosa-dice-la-legge', label: 'Cosa dice la legge nel 2026' },
  { id: 'casa-mobile-vs-costruzione', label: 'Casa mobile o costruzione: la sottile linea giuridica' },
  { id: 'decreto-casa', label: 'L\'eccezione delle strutture ricettive all\'aperto' },
  { id: 'paesaggistica', label: 'Autorizzazione paesaggistica: la novità DPR 73/2026' },
  { id: 'terreno-privato', label: 'Casa mobile su terreno privato' },
  { id: 'terreno-agricolo', label: 'Casa mobile su terreno agricolo' },
  { id: 'residenza', label: 'Residenza in casa mobile: si può?' },
  { id: 'omologazione', label: 'Omologazione e targa: quando servono' },
  { id: 'normative-regionali', label: 'Normative regionali (overview)' },
  { id: 'sentenze', label: 'Sentenze chiave del Consiglio di Stato' },
  { id: 'faq', label: 'Domande frequenti' },
];

const faq = [
  { q: 'Serve un permesso per mettere una casa mobile in campeggio?', a: 'In genere no. L\'<strong>art. 3, comma 1, lettera e.5) del DPR 380/2001</strong> esclude dalla nuova costruzione le unità abitative mobili con meccanismi di rotazione in funzione, collocate in strutture ricettive all\'aperto già autorizzate, senza collegamento permanente al terreno e nel rispetto delle norme regionali.' },
  { q: 'Posso mettere una casa mobile sul mio terreno privato?', a: 'Sì, ma con permesso di costruire se l\'installazione è permanente. Se mantieni le ruote funzionanti, gli allacciamenti smontabili e l\'uso temporaneo, in alcuni casi può essere considerata bene mobile (art. 3, lettera e.5, DPR 380/2001). Prima di comprare chiedi parere scritto al Comune.' },
  { q: 'E sul terreno agricolo?', a: 'Solo per uso temporaneo legato all\'attività agricola (es. ricovero attrezzi stagionale). <strong>Mai</strong> come abitazione permanente. Una casa mobile abitata stabilmente è nuova costruzione ai sensi dell\'art. 3 del DPR 380/2001, soggetta a permesso di costruire. Vedi <a href="/normativa/casa-mobile-terreno-agricolo">la guida dedicata</a>.' },
  { q: 'Posso prendere la residenza in una casa mobile?', a: 'Sì, in alcuni casi. La residenza si ottiene quando il Comune verifica che la casa mobile è dimora stabile della persona. Possibile se: (a) la casa è in campeggio aperto tutto l\'anno; (b) è su terreno privato con permessi regolari; (c) è usata come "fittizia residenza" per persone senza fissa dimora.' },
  { q: 'La casa mobile va omologata e targata?', a: 'Solo se la trasporti su strada come veicolo a traino. Per case installate stabilmente in campeggio non serve. Per spostarla in strada serve omologazione presso la Motorizzazione Civile come "rimorchio speciale" + libretto + revisione + targa.' },
  { q: 'Cos\'è la norma EN 1647?', a: 'È la <strong>norma europea</strong> di costruzione per i "leisure accommodation vehicles" (veicoli per alloggio del tempo libero), che include case mobili e maxi-caravan. Definisce requisiti di sicurezza strutturale, antincendio, impianti, isolamento. Chiedi sempre la conformità EN 1647 prima di acquistare un\'usata.' },
  { q: 'Cosa cambia con il Decreto Salva Casa 2024?', a: 'Per le case mobili, nulla di specifico. Il <strong>DL 69/2024</strong>, convertito dalla legge 105/2024, non nomina case mobili né campeggi e non tocca la lettera e.5) dell\'art. 3 del DPR 380/2001. La novità vera del 2026 è il <strong>DPR 73/2026</strong>, sul paesaggio.' },
  { q: 'Le sentenze del Consiglio di Stato cambiano qualcosa?', a: 'Sì. Il criterio è la precarietà, che il Consiglio di Stato (sez. II, 1489/2023) legge come «temporale, funzionale e costruttiva». Vale per tutto ciò che si dichiara amovibile: <strong>conta l\'uso, non i materiali</strong>. Le ruote da sole non bastano.' },
];

const correlati = [
  { href: '/normativa/casa-mobile-terreno-agricolo', category: 'Normativa', title: 'Casa mobile su terreno agricolo: cosa dice davvero la legge nel 2026', excerpt: 'Cosa dice il DPR 380/2001, cosa cambia con la funzione agricola, quali rischi corri.', readTime: '8 min' },
  { href: '/vivere/residenza-casa-mobile', category: 'Vivere', title: 'Residenza in casa mobile: come ottenerla nel 2026', excerpt: 'Iter completo per ottenere la residenza in casa mobile, in campeggio o su terreno privato.', readTime: '6 min' },
  { href: '/normativa/decreto-casa-spiegato', category: 'Normativa', title: 'Decreto Casa e Salva Casa: cosa cambia davvero per le case mobili', excerpt: 'Il Salva Casa non nomina le case mobili. Da dove viene davvero la regola sui campeggi.', readTime: '9 min' },
];
---

<BaseLayout title={title} description={description}>
  <article class="max-w-7xl mx-auto px-4 md:px-6 py-8">
    <SchemaBreadcrumb items={[{ name: 'Home', url: '/' }, { name: 'Normativa', url: '/normativa' }]} />
    <SchemaWebPage type="CollectionPage" title={title} description={description} url={url} />

    <header class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider mb-4" style="background-color:var(--color-forest-100);color:var(--color-forest-800)">Pilastro · Normativa</div>
      <h1>{title}</h1>
      <p class="text-lg md:text-xl mt-6 leading-relaxed" style="color:var(--color-ink-700)">
        Ordine di rimozione, arresto fino a due anni, ammenda da 5.164 a 51.645 euro: è il quadro dell'art. 44 del DPR 380/2001 per chi costruisce senza permesso. Il problema: <em>dove si può</em> non è scritto in un punto solo. È diviso tra Testo Unico Edilizia, DPR 73/2026, leggi regionali e sentenze. Questa guida le mette in fila.
      </p>
      <div class="flex items-center gap-4 mt-6 text-sm" style="color:var(--color-ink-500)">
        <span>A cura di Andrea Bressan</span>
        <span>·</span>
        <span>Aggiornato il 19 maggio 2026</span>
        <span>·</span>
        <span>15 min di lettura</span>
      </div>
    </header>

    <div class="grid lg:grid-cols-12 gap-12 mt-12">
      <aside class="lg:col-span-3 hidden lg:block">
        <div class="sticky top-20">
          <div class="text-xs uppercase tracking-wider font-semibold mb-3" style="color:var(--color-brass-700)">Indice</div>
          <ul class="space-y-2 text-sm">
            {toc.map((t) => (
              <li><a href={`#${t.id}`} class="no-underline hover:underline" style="color:var(--color-ink-700)">{t.label}</a></li>
            ))}
          </ul>
          <div class="mt-8">
            <FbCommunityWidget variant="sidebar" />
          </div>
        </div>
      </aside>

      <div class="lg:col-span-9 prose-article" style="margin:0">
        <Tldr>
          <p class="m-0"><strong>Le 5 cose da sapere subito</strong></p>
          <ol class="my-2">
            <li>In <strong>campeggio o villaggio</strong>: nessun titolo edilizio, alle condizioni dell'art. 3 del DPR 380/2001.</li>
            <li>Su <strong>terreno privato</strong>: permesso di costruire se l'installazione è permanente.</li>
            <li>Su <strong>terreno agricolo</strong>: solo uso temporaneo, mai abitazione stabile.</li>
            <li>La <strong>residenza è ottenibile</strong> in alcune condizioni (vedi sezione dedicata).</li>
            <li>Conta l'<strong>uso reale, non i materiali</strong>: lo dice il Consiglio di Stato.</li>
          </ol>
        </Tldr>

        <h2 id="cosa-dice-la-legge">Cosa dice la legge nel 2026</h2>
        <p>Tre sono i riferimenti che devi conoscere. Il <a href="https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:decreto.legge:2024-05-29;69">Salva Casa (DL 69/2024)</a> non è fra questi: non nomina case mobili né campeggi.</p>
        <ol>
          <li><a href="https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:decreto.del.presidente.della.repubblica:2001-06-06;380~art3"><strong>Testo Unico Edilizia (DPR 380/2001), art. 3, lettera e.5)</strong></a>: dice quando una casa mobile è nuova costruzione e quando no. È la regola che conta.</li>
          <li><strong>DPR 73/2026</strong>: in vigore dal 27 maggio 2026, toglie l'autorizzazione paesaggistica nei campeggi già autorizzati, a condizioni precise.</li>
          <li><strong>Normative regionali</strong>: le caratteristiche delle strutture ricettive all'aperto e delle unità ammesse le fissano le Regioni.</li>
        </ol>
        <p>A questi si aggiunge la <strong>norma tecnica europea EN 1647</strong>, che fissa i requisiti di salute e sicurezza delle case mobili da vacanza. È una norma tecnica, non una legge.</p>

        <h2 id="casa-mobile-vs-costruzione">Casa mobile o costruzione: la sottile linea giuridica</h2>
        <p>Il dibattito giuridico chiave è uno: <strong>quando una casa mobile diventa "costruzione"?</strong> La risposta non sta nei materiali (legno, alluminio, ruote), ma nell'<strong>uso</strong>:</p>
        <ul>
          <li>Casa mobile <strong>itinerante</strong> o <strong>temporanea</strong> → bene mobile, no permesso.</li>
          <li>Casa mobile <strong>ancorata stabilmente</strong>, con allacciamenti permanenti, abitata in modo continuativo → equivalente a nuova costruzione, sì permesso.</li>
        </ul>
        <p>Il Consiglio di Stato parla di precarietà «temporale, funzionale e costruttiva» (<a href="https://mdp.giustizia-amministrativa.it/visualizza/?nodeRef=&schema=cds&nrg=202204426&nomeFile=202301489_11.html&subDir=Provvedimenti">sezione II, sentenza 1489/2023</a>).</p>

        <h2 id="decreto-casa">L'eccezione delle strutture ricettive all'aperto</h2>
        <p>Se la casa mobile va in <strong>campeggio o villaggio</strong>, non è nuova costruzione quando sono vere tutte queste condizioni (<a href="https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:decreto.del.presidente.della.repubblica:2001-06-06;380~art3">art. 3, comma 1, lettera e.5, DPR 380/2001</a>): meccanismi di rotazione in funzione, struttura già autorizzata, nessun collegamento permanente al terreno, norme regionali rispettate. Significa che:</p>
        <ul>
          <li>Non serve <strong>permesso di costruire</strong>.</li>
          <li>Non serve <strong>SCIA</strong> né <strong>CILA</strong>.</li>
          <li>Valgono il regolamento della struttura e le regole regionali su dimensioni e caratteristiche.</li>
        </ul>
        <p>È la situazione in cui l'iter è più semplice. Per terreno privato e agricolo si torna alle regole ordinarie (sotto). Per il caso "campeggio in zona vincolata" è cambiato tutto a maggio 2026: vedi la sezione seguente.</p>

        <h2 id="paesaggistica">Autorizzazione paesaggistica: la novità DPR 73/2026</h2>
        <p>Fino al maggio 2026, una casa mobile in un campeggio sottoposto a <strong>vincolo paesaggistico</strong> poteva richiedere il nulla osta paesaggistico preventivo: iter lungo, esiti incerti. <strong>Dal 27 maggio 2026 non è più così.</strong></p>
        <p>Il <strong>DPR 73/2026</strong> (Gazzetta Ufficiale n.108 del 12 maggio 2026), modificando il DPR 31/2017, <strong>esclude dall'autorizzazione paesaggistica</strong> la collocazione di case mobili, caravan e autocaravan dentro strutture turistico-ricettive all'aperto già autorizzate — a sei condizioni precise (la prima: la struttura deve avere l'autorizzazione paesaggistica riferita anche alle aree attrezzate).</p>
        <p>Sono due piani: l'art. 3 del DPR 380/2001 riguarda il titolo <strong>edilizio</strong>, il DPR 73/2026 il nulla osta <strong>paesaggistico</strong>. Presupposti diversi, vanno verificati entrambi. <a href="/normativa/case-mobili-autorizzazione-paesaggistica">Le sei condizioni esatte e cosa fare in pratica nella guida dedicata</a>.</p>

        <h2 id="terreno-privato">Casa mobile su terreno privato</h2>
        <p>Su un terreno di tua proprietà puoi installare una casa mobile, ma con distinzioni importanti:</p>
        <ul>
          <li>Se la usi <strong>occasionalmente</strong> (weekend, vacanze) e mantieni le ruote funzionanti, può rientrare nei beni mobili — alcuni Comuni la accettano.</li>
          <li>Se la usi <strong>stabilmente</strong> (residenza, abitazione principale o secondaria), il Comune può chiederti il permesso di costruire.</li>
          <li>In ogni caso conta il <strong>regolamento urbanistico</strong> locale e le destinazioni d'uso del terreno.</li>
        </ul>
        <p>Consiglio pratico: prima di acquistare la casa mobile, vai all'ufficio tecnico del tuo Comune con la planimetria del terreno e chiedi un <strong>parere preventivo</strong> in forma scritta. Costa poco, ti tutela molto.</p>

        <h2 id="terreno-agricolo">Casa mobile su terreno agricolo</h2>
        <p>Questo è il caso più frequentemente sottovalutato. Il <strong>terreno agricolo</strong> ha vincoli urbanistici stringenti: in linea di principio, non puoi metterci una casa mobile come abitazione stabile.</p>
        <p>L'unica eccezione tipica: l'imprenditore agricolo professionale (IAP) che installa una casa mobile come ricovero <strong>strettamente funzionale all'attività agricola</strong>, in modo temporaneo. Anche in questo caso servono permessi specifici.</p>
        <p><a href="/normativa/casa-mobile-terreno-agricolo">Approfondisci nella guida dedicata</a> con casi reali, sentenze e cosa rischi se sbagli.</p>

        <h2 id="residenza">Residenza in casa mobile: si può?</h2>
        <p>Sì, ed è uno dei dubbi più diffusi. La residenza è il <strong>fatto</strong> di vivere abitualmente in un luogo, e si dichiara all'Ufficio Anagrafe del Comune. Per ottenerla in casa mobile servono:</p>
        <ul>
          <li>Un <strong>indirizzo verificabile</strong> dal Comune (la casa mobile deve essere identificabile).</li>
          <li>Una <strong>verifica di dimora abituale</strong> da parte della Polizia Municipale.</li>
          <li>Il <strong>diritto a stare lì</strong> (proprietà del terreno, contratto con il campeggio, ecc.).</li>
        </ul>
        <p>Funziona meglio in: campeggi aperti tutto l'anno (alcuni hanno residenti stabili da anni), terreni privati con permessi in regola.</p>
        <p>Possibile anche la <strong>residenza fittizia</strong> presso "Via della Casa Comunale" per chi non ha indirizzo fisso ma vuole mantenere accesso a sanità e diritti civili.</p>

        <h2 id="omologazione">Omologazione e targa: quando servono</h2>
        <p>Solo se trasporti la casa mobile <strong>su strada come veicolo</strong>. Per case installate in modo stabile in campeggio non serve.</p>
        <p>Procedura per omologazione e targa:</p>
        <ul>
          <li>Visita di omologazione presso la Motorizzazione Civile.</li>
          <li>Iscrizione come "rimorchio speciale".</li>
          <li>Libretto di circolazione.</li>
          <li>Targa.</li>
          <li>Revisione periodica.</li>
        </ul>
        <p>Costo tipico totale: 3.000–8.000 €. Più conveniente acquistare un rimorchio omologato a parte (~3.000 €) e posizionare la casa mobile sopra.</p>

        <h2 id="normative-regionali">Normative regionali (overview)</h2>
        <p>Ogni Regione italiana ha competenze proprie in materia urbanistica. Le differenze più rilevanti:</p>
        <ul>
          <li><a href="/normativa/regioni/veneto"><strong>Veneto</strong></a>: tradizione open-air molto forte, regolamento dei campeggi articolato.</li>
          <li><a href="/normativa/regioni/toscana"><strong>Toscana</strong></a>: vincoli paesaggistici severi, attenzione a zone protette.</li>
          <li><a href="/normativa/regioni/lazio"><strong>Lazio</strong></a>: situazione frammentata, dipende molto dal Comune.</li>
          <li><a href="/normativa/regioni/campania"><strong>Campania</strong></a>: zone vulcaniche con regolamenti specifici.</li>
          <li><a href="/normativa/regioni/sicilia"><strong>Sicilia</strong></a>: regime speciale e PRG comunali eterogenei.</li>
        </ul>

        <h2 id="sentenze">Sentenze chiave del Consiglio di Stato</h2>
        <p>Citiamo solo ciò che abbiamo letto alla fonte.</p>
        <ul>
          <li><a href="https://mdp.giustizia-amministrativa.it/visualizza/?nodeRef=&schema=cds&nrg=202204426&nomeFile=202301489_11.html&subDir=Provvedimenti"><strong>CdS, sez. II, 1489/2023</strong></a>: la precarietà va intesa in un'accezione «che è nel contempo temporale, funzionale e costruttiva». Il caso riguardava un'altra struttura, ma il principio vale per tutto ciò che si dichiara amovibile.</li>
        </ul>

        <FbCommunityWidget variant="card" />

        <FaqAccordion items={faq} title="Domande frequenti sulla normativa" />
      </div>
    </div>

    <section class="mt-24">
      <div class="flex items-end justify-between mb-8 flex-wrap gap-4">
        <h2 style="margin-top:0">Approfondimenti del cluster Normativa</h2>
        <a href="/normativa" class="text-sm font-medium no-underline hover:underline" style="color:var(--color-forest-700)">Vedi tutte →</a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {correlati.map((a) => <ArticleCard {...a} />)}
      </div>
    </section>
  </article>

  <SchemaArticle
    title={title}
    description={description}
    datePublished="2026-04-29"
    dateModified="2026-04-29"
    url={fullUrl}
  />
</BaseLayout>
